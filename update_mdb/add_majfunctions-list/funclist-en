	fi

	cd $(find "${DEST}" -type d \( -not -name ".git" -o -not -name ".cache" \) | grep -v "\.git\|\.cache" | fzf -e --reverse)
}

vimb() {
# descpt: vim filename, but create filename-backup first
	if [ $# -ne 1 ]; then
		vim
	else
		local fname
		fname="$1"
		if [ ! -f "${fname}" ]; then
			printf "[E] no such file: '%s'\n\n" "${fname}"
			exit 1
		fi

		if [ -f "${fname}-backup" ]; then
			printf "[i] backup file already exists\n"
			vim "${fname}"
		else
			cp -v "${fname}" "${fname}-backup"
			vim "${fname}"
		fi
	fi
}

