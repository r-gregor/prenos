crtice() {
# descpt: draw line of '-' across the screen, or number of them supplied as function argument
	screen_wdth=$(tput cols)

	if [ $# -ne 1 ]; then
		stznk="${screen_wdth}"
	else
		stznk="${1}"
		if ! [[ "${stznk}" =~ ^[0-9]+$ ]]; then
			printf "[E] supplied parameter is NOT a number\n\n"
			exit 1
		fi

		if [ "${stznk}" -gt "${screen_wdth}" ]; then
			stznk="${screen_wdth}"
		fi
	fi
	printf "%${stznk}s\n" | tr " " "-"
}

cdh() {
# descpt: cd to directory relative to ${HOME}
	if [ $# -ne 1 ]; then
		printf "[U] usage: cdh <path relative to \$HOME>\n\n"
		return
	else
		RELPTH="$1"
		cd "${HOME}/${RELPTH}"
	fi
}

upup() {
# descpt: go up to parent directories $DEEP levels
	DEEP=$1

	[ -z "${DEEP}" ] && { DEEP=1; }

	if ! [[ "${DEEP}" =~ ^[0-9]+$ ]]; then
		printf "[E] supplied parameter is NOT a number\n\n"
		exit 1
	fi

	for i in $(seq 1 ${DEEP}); do
		cd ../
	done
}

