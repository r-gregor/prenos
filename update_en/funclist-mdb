skrn() {
# descpt: starts new terminal (xfce4-terminal) window with screen session divided into multiple windows ...
	gr_FJL="~/.screen-lyt"
	if [ $1 -eq 0 ] || [ $1 -eq 1 ] || [ $1 -eq 2 ] || [ $1 -eq 3 ]; then
		gr_PRM=$1
		xfce4-terminal -e "screen -c ${gr_FJL}-0${gr_PRM}" & 2>/dev/null

	elif [ $1 == "db" ]; then
		xfce4-terminal -e "screen -c ${gr_FJL}-db" & 2>/dev/null

	else
		gr_PRM="0"
		xfce4-terminal -e "screen -c ${gr_FJL}-0${gr_PRM}" & 2>/dev/null
	fi
}


