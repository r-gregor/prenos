prompt_switch() {
# descpt: switch prompts from fzf-list
	prompts=$(for FFF in ~/majstaf/majrcs/bashrc-prompt-*; do echo $(basename $FFF); done;)
	quit=$(echo "quit")
	choice=$(echo -e "${prompts}\n${quit}" | fzf --reverse -e)
	if [ "$choice" == "quit" ]; then
		:
	else
		source ~/majstaf/majrcs/${choice}
	fi
}

prompt_switch_dmn() {
# descpt: switch prompts from dmenu-list
	prompts=$(for FFF in ~/majstaf/majrcs/bashrc-prompt-*; do echo $(basename $FFF); done;)
	quit=$(echo "quit")
	choice=$(echo -e "${prompts}\n${quit}" | dmenu -l 5 -p "choose prompt:")
	if [ "$choice" == "quit" ]; then
		:
	else
		source ~/majstaf/majrcs/${choice}
	fi
}

prompt_switch_rofi() {
# descpt: switch prompts from rofi-list
	prompts=$(for FFF in ~/majstaf/majrcs/bashrc-prompt-*; do echo $(basename $FFF); done;)
	quit=$(echo "quit")
	choice=$(echo -e "${prompts}\n${quit}" | rofi -dmenu -no-fixed-num-lines)
	if [ "$choice" == "quit" ]; then
		:
	else
		source ~/majstaf/majrcs/${choice}
	fi
}

